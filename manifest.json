{
  "manifest_version": 3,
  "name": "Aggressive YouTube Filter",
  "version": "4",
  "description": "Automatically clicks Not Interested on meaningless recommendations like already watched videos and Mix suggestions.",
  "minimum_chrome_version": "148",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "aggressive-youtube-filter-sharp-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "aggressive-youtube-filter@klesun",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  }
}
